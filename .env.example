# ── Required ────────────────────────────────────────────────────────────────

# Todoist API token
# Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=

# Notion integration secret
# https://www.notion.so/my-integrations → New integration → Internal → copy Secret
NOTION_API_TOKEN=

# Notion database ID for your Work tasks database
# Open the database in Notion → copy the 32-character ID from the URL
WORK_DATABASE_ID=

# Notion database ID for your Personal tasks database
PERSONAL_DATABASE_ID=

# ── Recommended ─────────────────────────────────────────────────────────────

# Notion database ID for storing Todoist sync state
# Enables incremental sync via the Todoist Sync API (much faster, fewer API calls)
# Without this, the app falls back to the slower REST API on every run
SYNC_STATE_DATABASE_ID=

# ── Optional ────────────────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=info

# How many days back to look for completed tasks (legacy REST fallback only)
# Default: 90
COMPLETED_LOOKBACK_DAYS=90

# IANA time zone for comment timestamps shown in Notion page bodies
# Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Default: Asia/Kolkata
DISPLAY_TIME_ZONE=Asia/Kolkata

# Maximum image attachment size to upload into Notion, in bytes
# Default: 5242880 (5 MB)
MAX_IMAGE_UPLOAD_BYTES=5242880
